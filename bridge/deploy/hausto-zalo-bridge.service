# systemd unit for the Zalo bridge. Installed by deploy.sh.
[Unit]
Description=Hausto Zalo bridge
Documentation=file:///opt/hausto-bridge/app/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hausto
Group=hausto
WorkingDirectory=/opt/hausto-bridge/app
EnvironmentFile=/opt/hausto-bridge/.env
ExecStart=/usr/bin/node --experimental-transform-types src/main.ts
# The bridge retries a failed Zalo login and an unreachable Hausto itself,
# backing off (bridge.ts loginRetryDelay, passRetryDelay), so this only brings
# it back from a crash. Repeated crashes wait longer each time, up to 30
# minutes, so a crash at start-up cannot become a login storm: every start
# logs in to Zalo. (RestartSteps needs systemd 254+; older ones ignore it and
# keep the flat 30 s.)
Restart=always
RestartSec=30
RestartSteps=6
RestartMaxDelaySec=30min

# It needs to read its code, write its state, and make outbound HTTPS calls.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/hausto-bridge/state
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
