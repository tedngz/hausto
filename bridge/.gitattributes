# Everything in bridge/ runs on Linux. A Windows checkout (core.autocrlf)
# would otherwise hand the server scripts with CRLF endings, which bash reads
# as part of each command: `set -euo pipefail\r` fails before anything runs.
*.sh      text eol=lf
*.service text eol=lf
*.yaml    text eol=lf
*.ts      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
